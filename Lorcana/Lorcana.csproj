    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Lorcana.App</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Framework/MiniHttpServer.Framework.csproj" />
